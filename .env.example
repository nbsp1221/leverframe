# Absolute path shared by the application and the host sandboxd daemon.
APP_DATA_DIRECTORY=${PWD}/.leverframe
REVIEWER_PORT=6571
WEB_PORT=6572

# Private operator URL used for the GitHub App homepage and setup callback.
APP_UI_BASE_URL=https://app.example.com
# Exact public URL GitHub can reach for webhook delivery.
GITHUB_WEBHOOK_URL=https://api.example.com/webhooks/github

# Stable numeric ID of the only GitHub account allowed to run jobs.
GITHUB_ALLOWED_OWNER_ID=12345678
# GitHub App names must be unique across GitHub.
GITHUB_APP_NAME=example-reviewer

# Review model used inside disposable Docker Sandboxes.
REVIEW_MODEL=gpt-5.6-sol
REVIEW_REASONING_EFFORT=high
# Required content-addressed local template printed by install.sh.
REVIEW_SANDBOX_TEMPLATE=leverframe-review-sandbox:sha256-0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

# Optional first development-loop repository. Omit to disable development runs.
# Paths are inside the reviewer container; compose mounts the host Codex skills read-only here.
DEVELOPMENT_COMMIT_SKILL_DIRECTORY=/agent-skills/commit
DEVELOPMENT_CREATE_PR_SKILL_DIRECTORY=/agent-skills/create-pr
# Deterministic command required before a candidate can request publication approval.
DEVELOPMENT_VERIFICATION_COMMAND=pnpm check

# Override when sbx is installed outside /usr/bin.
SANDBOX_CLI_PATH=/usr/bin/sbx

# Optional loopback bind addresses for local smoke tests.
REVIEWER_BIND_ADDRESS=127.0.0.1
WEB_BIND_ADDRESS=127.0.0.1
