{
  "$schema": "https://turbo.build/schema.json",
  "tasks": {
    "build": {
      "env": ["REVIEWER_INTERNAL_URL"],
      "dependsOn": ["^build"],
      "outputs": ["dist/**", ".next/**", "!.next/cache/**", "!.next/dev/**"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "typecheck": {
      "dependsOn": ["^typecheck"],
      "outputs": []
    },
    "test": {
      "cache": false
    },
    "test:unit": {
      "cache": false
    },
    "test:integration": {
      "cache": false
    },
    "test:e2e": {
      "cache": false
    },
    "test:dist": {
      "dependsOn": ["build"],
      "cache": false
    }
  }
}
