{
  "name": "@repo/reviewer",
  "version": "0.0.0",
  "private": true,
  "description": "Leverframe code review bot and GitHub integration",
  "license": "MIT",
  "author": "nbsp1221",
  "bin": {
    "leverframe": "dist/cli.js"
  },
  "type": "module",
  "scripts": {
    "build": "tsdown && node scripts/copy-scalar-browser.mjs",
    "dev": "tsx src/cli.ts",
    "test": "vitest run",
    "test:dist": "node dist/cli.js --version",
    "test:e2e": "vitest run --project e2e",
    "test:integration": "vitest run --project integration",
    "test:unit": "vitest run --project unit",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@hono/node-server": "2.1.1",
    "@hono/zod-openapi": "1.6.1",
    "@octokit/app": "16.1.4",
    "@repo/contracts": "workspace:*",
    "@scalar/hono-api-reference": "0.11.14",
    "cac": "7.0.0",
    "execa": "10.0.1",
    "hono": "4.13.3",
    "ws": "^8.22.0",
    "yaml": "^2.9.0",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@repo/typescript-config": "workspace:*",
    "@scalar/api-reference": "1.65.1",
    "@scalar/openapi-to-markdown": "0.5.40",
    "@types/ws": "^8.18.2"
  },
  "engines": {
    "node": ">=24.0.0"
  }
}
