{
  "extends": "@repo/typescript-config/nextjs.json",
  "compilerOptions": { "allowJs": false, "incremental": true },
  "include": [
    "next-env.d.ts",
    ".next/types/**/*.ts",
    "src/**/*.ts",
    "src/**/*.tsx",
    "app/**/*.ts",
    "app/**/*.tsx",
    "e2e/**/*.ts",
    "proxy.ts",
    "next.config.ts",
    "playwright.config.ts",
    "vitest.config.ts"
  ],
  "exclude": ["node_modules"]
}
